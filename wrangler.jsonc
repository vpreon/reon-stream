{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reon-stream",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // Hardcoded for now — switch back to secrets later with:
  //   npx wrangler secret put ADMIN_PASSWORD / STREAM_PASSWORD  (and remove these vars)
  // ADMIN_PASSWORD: upload, add, delete + watch. STREAM_PASSWORD: watch only.
  "vars": {
    "ADMIN_PASSWORD": "Vp485123",
    "STREAM_PASSWORD": "P@ss485123"
  },

  // Video catalogue lives in D1; the actual video files live in R2.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reon-stream-db",
      "database_id": "9fec9a08-4da2-47ed-818c-29306ac008ae"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "reon-stream"
    }
  ]

  // Secret (set via CLI, never in this file):
  //   npx wrangler secret put APP_PASSWORD
  // For local dev, put APP_PASSWORD=... in .dev.vars
}
